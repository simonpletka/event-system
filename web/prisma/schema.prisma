// Event system schema. Phase 1: Dashboard, Events. Phase 2: Finance (Quotes,
// Invoices, Expenses, Reports). Time tracker/Settings tables are still stubs.
// See /CLAUDE.md and docs/system_info/event-system-zadani.pdf for background.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  ACCOUNTANT
  PRODUCER
  MEMBER
}

// Access tiers for custom roles — one enum per module, matching the granularity
// the four built-in roles already use (see resolvePermissions() in authz.ts,
// which maps ADMIN/ACCOUNTANT/PRODUCER/MEMBER onto these same tiers so both
// built-in and custom roles flow through one set of checks).
enum EventsAccess {
  NONE
  ASSIGNED_READ // Member: assigned events, read-only
  OWN_EDIT // Producer: own/assigned events, can edit
  ALL_READ // Accountant: all events, read-only
  ALL_FULL // Admin: all events, full access
}

enum FinanceAccess {
  NONE
  READ_OWN_EVENTS // Producer: view quotes/invoices on own events
  FULL
}

enum ExpensesAccess {
  NONE
  OWN_ONLY // Member: add/view own expenses only
  ADD_ON_OWN_EVENTS // Producer: add/view expenses on own/assigned events
  FULL
}

enum SettingsAccess {
  NONE
  COMPANY // Accountant: company data + invoice template
  USERS_AND_COMPANY // Admin: users & roles too
}

// User-defined role with its own configurable reach, additive to the four
// built-in roles (which stay hardcoded and unchanged). A user has either a
// built-in Role or a CustomRole, never both in effect — see resolvePermissions().
model CustomRole {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  events   EventsAccess   @default(NONE)
  finance  FinanceAccess  @default(NONE)
  expenses ExpensesAccess @default(NONE)
  settings SettingsAccess @default(NONE)

  users User[]
}

enum EventStatus {
  INQUIRY // Poptávka
  QUOTE_SENT // Nabídka odeslána
  CONFIRMED // Potvrzeno
  IN_PROGRESS // V realizaci
  TO_INVOICE // Proběhlo — k vyfakturování
  CLOSED // Uzavřeno
  CANCELLED // Zrušeno — added beyond the brief's 4.3 table, which invites it
}

enum ExpenseCategory {
  FOOD
  GROCERY
  TRAVEL_GAS
  TRAVEL_CAR
  TRAVEL_FLIGHT
  TRAVEL_TAXI
  TRAVEL_PARKING
  TRAVEL_PUBLIC_TRANSPORT
  TRAVEL_OTHER
  GEAR
  GENERIC
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

// OVERDUE is deliberately not a stored state — it's derived from
// (dueDate < now && status != PAID) so it can't go stale without a cron job.
enum InvoiceStatus {
  ISSUED
  PARTLY_PAID
  PAID
}

enum InvoiceEventType {
  CREATED
  ISSUED
  PAYMENT_RECORDED
  MARKED_PAID
  PAID_REVERTED
  EMAILED
  REMINDER_SENT
  DRIVE_EXPORT_FAILED
}

enum DiscountType {
  NONE
  PERCENT
  FIXED
}

// Event's internal spend cap (separate from the client-facing quotedValue).
// Set manually by an Admin on the event form: a percentage of quotedValue,
// or a flat amount. Same shape as DiscountType but kept distinct so the two
// never get accidentally coupled — the budget percent range is wider (a
// loss-leader event can be budgeted above 100% of what was quoted).
enum BudgetType {
  NONE
  PERCENT
  FIXED
}

// A single dated thing on an event's Roadmap tab. MILESTONE rows are the old
// Milestone model migrated forward; TASK/MEETING are user-created. Production
// phases (build / event days / strike) are derived from the Event's own
// date fields at render time, not stored as rows.
enum RoadmapItemType {
  MILESTONE
  TASK
  MEETING
}

// Per-document currency (brief: default CZK, switchable when creating a
// quote; an invoice created from that quote inherits it). Deliberately no
// exchange-rate conversion anywhere — aggregate stats (Reports, Dashboard,
// event budget-vs-actual) keep summing the raw Int amounts as before and
// are documented as CZK-only, so a stray EUR/USD document will skew them.
// That's an accepted simplification, not a bug — see CLAUDE.md.
enum Currency {
  CZK
  EUR
  USD
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String    @default("") // shown on a quote's "Created by" block alongside name/email
  passwordHash String
  role         Role // fallback/least-privilege value when customRoleId is set — see resolvePermissions()
  isCardHolder Boolean   @default(false)
  active       Boolean   @default(true) // deactivated accounts can't log in; history is kept, not deleted
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime?
  avatarPath   String? // Settings → General profile photo, same disk-storage pattern as CompanySettings.logoPath
  locale       String? // "en" | "cs"; null inherits CompanySettings.locale — per-account override, see getLocale()

  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])

  ownedEvents         Event[]           @relation("EventOwner")
  assignments         EventMember[]
  expenses            Expense[]
  timeEntries         TimeEntry[]
  createdQuotes       Quote[]           @relation("QuoteCreator")
  payments            Payment[]
  invoiceEvents       InvoiceEvent[]
  roadmapItemsCreated RoadmapItem[]     @relation("RoadmapItemCreatedBy")
  roadmapAssignments  RoadmapAssignee[] @relation("RoadmapAssignee")
  roadmapComments     RoadmapComment[]  @relation("RoadmapCommentAuthor")
  meetingsCreated     Meeting[]
}

model Event {
  id      String @id @default(cuid())
  // Short display identifier, "YY-XXX" (e.g. "26-001") — see document-number.ts.
  // Assigned once at creation by finding the lowest unused XXX for the
  // current year, so a permanently-deleted event's number becomes reusable
  // rather than just skipped. Quote/Invoice numbers are derived from this.
  number         String      @unique
  title          String
  brief          String      @default("")
  companyName    String
  companyAddress String      @default("")
  companyIco     String      @default("")
  companyDic     String      @default("")
  status         EventStatus @default(INQUIRY)

  // Added going forward — see the Client model's own comment for why old
  // events aren't auto-migrated onto this. Event's own embedded
  // client/company fields above are untouched and still what every other
  // screen (PDFs, event detail, quotes/invoices) reads from; clientId only
  // powers the Clients section's per-client event/revenue rollup.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // Set (best-effort) after the event's Notion page is created — see
  // tryCreateNotionEventPage() in lib/notion.ts. Null when Notion isn't
  // configured or the push failed; a Meeting synced afterward just skips
  // this event in its "Events" relation property when null.
  notionPageId String?

  buildDate  DateTime?
  startDate  DateTime
  endDate    DateTime
  strikeDate DateTime?

  quotedValue Int @default(0) // minor currency units avoided; brief uses whole CZK

  // Internal budget — Admin-set, Admin-editable, visible to finance/event
  // roles only (see canViewEventBudget). budgetValue holds a percent of
  // quotedValue (0-300) when PERCENT, or a whole-CZK amount when FIXED;
  // ignored when NONE. Resolve via resolveEventBudget().
  budgetType  BudgetType @default(NONE)
  budgetValue Int        @default(0)

  ownerId String
  owner   User   @relation("EventOwner", fields: [ownerId], references: [id])

  venues       Venue[]
  roadmapItems RoadmapItem[]
  members      EventMember[]
  expenses    Expense[]
  timeEntries TimeEntry[]
  quotes      Quote[]
  invoices    Invoice[]
  contacts    EventContact[]
  meetings    MeetingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([status])
}

// One or more contact people for an event's client side. Replaces the old
// single clientName/clientPhone/clientEmail fields — an event can have 1+
// contacts, and saving the event auto-syncs each onto the linked Client's
// own contact list (see resolveClientId/syncClientContacts in
// lib/actions/clients.ts). Deleting a synced ClientContact from the Client
// page doesn't touch this row — the two are independent copies, not linked
// by a foreign key, so removing one never silently loses the other.
model EventContact {
  id        String @id @default(cuid())
  eventId   String
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  phone     String @default("")
  email     String @default("")
  sortOrder Int    @default(0)
}

// Producer/Member assignment to an event — drives §2.2 visibility rules.
model EventMember {
  id      String @id @default(cuid())
  eventId String
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Venue {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  address String
  note    String @default("")
}

// Replaces the old Milestone model. Drives the event detail's Roadmap tab —
// tasks, client meetings and production milestones in one dated list, each
// assignable to team members (assigning auto-adds an EventMember) and open
// to a comment thread. Calendar/Meet sync is deferred (see TODO.md at the
// repo root); googleCalendarEventId / googleMeetUrl are carried but never
// populated yet.
model RoadmapItem {
  id                    String          @id @default(cuid())
  eventId               String
  event                 Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type                  RoadmapItemType
  title                 String
  date                  DateTime
  allDay                Boolean         @default(false)
  done                  Boolean         @default(false)
  note                  String          @default("")
  googleCalendarEventId String?
  googleMeetUrl         String?
  createdById           String?
  createdBy             User?           @relation("RoadmapItemCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignees         RoadmapAssignee[]
  externalAttendees RoadmapExternalAttendee[]
  comments          RoadmapComment[]

  @@index([eventId, date])
}

// Team member assigned to a roadmap item. Creating one also upserts an
// EventMember (see actions/roadmap.ts) so the person can see the event;
// removing one never touches the EventMember.
model RoadmapAssignee {
  id     String      @id @default(cuid())
  itemId String
  userId String
  item   RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User        @relation("RoadmapAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

// External (non-User) attendee on a MEETING roadmap item — a deliberate
// free-text copy, no FK back to Client/ClientContact (same pattern as
// EventContact).
model RoadmapExternalAttendee {
  id     String      @id @default(cuid())
  itemId String
  item   RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name   String
  email  String      @default("")
}

// User-authored comment on a roadmap item. Structure mirrors InvoiceEvent:
// nullable author (kept if the user is later deleted), createdAt default,
// indexed by parent + time.
model RoadmapComment {
  id        String      @id @default(cuid())
  itemId    String
  item      RoadmapItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation("RoadmapCommentAuthor", fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now())

  @@index([itemId, createdAt])
}

enum MeetingType {
  CLIENT
  INTERNAL
}

// Computed, not materialized: a recurring Meeting is one row with a rule;
// occurrences are expanded on demand (see expandMeetingOccurrences() in
// lib/meetings.ts) for calendar display rather than stored per-instance.
// Editing a recurring Meeting edits the whole series — no single-occurrence
// edit/cancel in v1.
enum RecurrenceFreq {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

// Company-wide meeting, independent of RoadmapItem (which is single-event-
// scoped) — a Meeting can relate to zero, one, or many events, and an event
// can have many meetings, via the MeetingEvent join model (same explicit-
// join-model shape as EventMember/RoadmapAssignee — no implicit many-to-many
// exists anywhere else in this schema). Synced one-way, best-effort, to a
// Notion database (Client Meetings or Internal Meetings by type) on create —
// see tryCreateNotionMeetingPage() in lib/notion.ts.
model Meeting {
  id                 String         @id @default(cuid())
  title              String
  type               MeetingType
  date               DateTime // anchor date/time of the first (or only) occurrence
  allDay             Boolean        @default(false)
  attendees          String         @default("") // free text — internal and/or external names
  note               String         @default("")
  recurrenceFreq     RecurrenceFreq @default(NONE)
  recurrenceInterval Int            @default(1)
  recurrenceUntil    DateTime? // inclusive end date; null = no end date (or non-recurring)
  createdById        String?
  createdBy          User?          @relation(fields: [createdById], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  events     MeetingEvent[]
  exceptions MeetingException[]

  @@index([date])
  @@index([type])
}

model MeetingEvent {
  id        String  @id @default(cuid())
  meetingId String
  eventId   String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([meetingId, eventId])
}

// A single overridden occurrence of a recurring Meeting — created by
// dragging one occurrence on the calendar and choosing "this occurrence
// only" (see rescheduleMeetingOccurrenceAction). `originalDate` is the exact
// date the base recurrence rule would otherwise produce; `newDate` is where
// it's displayed instead. Never created for a non-recurring Meeting — those
// reschedule by updating `Meeting.date` directly.
model MeetingException {
  id           String   @id @default(cuid())
  meetingId    String
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  originalDate DateTime
  newDate      DateTime

  @@unique([meetingId, originalDate])
}

// --- Minimal stubs for later phases; kept here so the event detail's
// counts/sums (expenses, time, quotes & invoices) are real data now. ---

model Expense {
  id          String          @id @default(cuid())
  eventId     String? // null = company overhead, not tied to an event
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  paidById    String
  paidBy      User            @relation(fields: [paidById], references: [id])
  amount      Int
  date        DateTime
  category    ExpenseCategory
  note        String          @default("")
  receiptPath String? // relative path under web/uploads/receipts, served via an authed route
  approved    Boolean         @default(true) // approval workflow not built yet; expenses count immediately
  createdAt   DateTime        @default(now())

  @@index([eventId])
  @@index([date])
}

enum TimePhase {
  PLANNING
  SUPPLIERS
  ON_SITE
  WRAP_UP
}

model TimeEntry {
  id          String    @id @default(cuid())
  eventId     String? // null = not yet assigned to an event; assign later via edit
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  minutes     Int       @default(0) // 0 while running; set on stop, or directly for manual entries
  date        DateTime
  description String    @default("")
  phase       TimePhase @default(PLANNING)

  // Only one entry per user should have running=true at a time — enforced in
  // the start-timer action (stops any prior running entry first), not the DB.
  running   Boolean   @default(false)
  startedAt DateTime?
  endedAt   DateTime?

  @@index([userId, running])
}

model Quote {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  number     String
  total      Int
  currency   Currency    @default(CZK)
  status     QuoteStatus @default(DRAFT)
  validUntil DateTime
  issuedAt   DateTime    @default(now())
  // When true (the default), the PDF/preview hide each item's individual
  // price and show only each category's subtotal plus the grand total —
  // useful for a client-facing breakdown that doesn't reveal per-item cost.
  hideItemPrices Boolean @default(true)

  // Who made this quote — shown on the detail page as "Created by" (name,
  // email, phone) alongside issuedAt as the creation date. No separate
  // createdAt field: issuedAt is already set at creation time via
  // @default(now()) and is never independently editable, so it already IS
  // the creation timestamp — adding another one would just duplicate it.
  createdById String
  createdBy   User   @relation("QuoteCreator", fields: [createdById], references: [id])

  items    QuoteItem[]
  invoices Invoice[] // an accepted quote that's been converted shows "Invoiced <number>" instead of "Convert"
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Int
  vatRate     Int    @default(21)
  // Free text, not a foreign key — matched against Settings' default
  // category list in the UI, but a quote can also introduce a one-off
  // category name that's never saved to that global list. Blank = uncategorized.
  category  String @default("")
  sortOrder Int    @default(0)
}

model Invoice {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  quoteId        String? // set when created via "convert quote to invoice"
  quote          Quote?        @relation(fields: [quoteId], references: [id])
  number         String
  variableSymbol String
  // `total` is the final, post-discount amount actually owed — the same
  // value every existing consumer (KPIs, reports, payment tracking) already
  // reads, so nothing downstream needed to change when discounts were added.
  total          Int
  currency       Currency      @default(CZK)
  amountPaid     Int           @default(0)
  status         InvoiceStatus @default(ISSUED)
  dueDate        DateTime
  issuedAt       DateTime      @default(now())
  paidAt         DateTime?
  hideItemPrices Boolean       @default(true) // see Quote.hideItemPrices
  discountType   DiscountType  @default(NONE)
  discountValue  Int           @default(0) // percent (0-100) if PERCENT, minor-currency amount if FIXED
  sentAt         DateTime? // last time the invoice itself was emailed (resending updates this)
  lastReminderAt DateTime? // last time an overdue reminder was emailed

  items    InvoiceItem[]
  payments Payment[]
  history  InvoiceEvent[]

  @@index([dueDate])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Int
  vatRate     Int     @default(21)
  category    String  @default("") // see QuoteItem.category
  sortOrder   Int     @default(0)
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Int
  date         DateTime @default(now())
  note         String   @default("")
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
}

// Small, targeted action log for the invoice detail's "History" panel —
// not a general audit log (that's still explicitly out of scope).
model InvoiceEvent {
  id        String           @id @default(cuid())
  invoiceId String
  invoice   Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      InvoiceEventType
  message   String
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())

  @@index([invoiceId, createdAt])
}

// Single-row company profile used to render invoice PDFs (supplier block,
// VAT handling, bank details for the QR payment code). No editing UI yet —
// that's Settings (Phase 4) — seeded directly for now.
model CompanySettings {
  id             String  @id @default("singleton")
  name           String
  address        String
  ico            String
  dic            String
  isVatPayer     Boolean @default(true)
  bankAccount    String  @default("") // IBAN; QR code is skipped if empty
  accountNumber  String  @default("") // local-format account number (e.g. "123456789/0300"); shown on invoice PDFs and split into ISDOC's account ID/bank-code pair
  swiftBic       String  @default("") // SWIFT/BIC; shown on invoice PDFs and in the embedded ISDOC's BankAccount/BIC
  defaultDueDays Int     @default(14)
  logoPath       String? // filename under uploads/logos/, served through an authenticated route like receipts
  accentColor    String  @default("#ec3013") // hex; drives BOTH the invoice PDF accent and the live app's --color-accent
  bgColor        String  @default("#131211")
  surfaceColor   String  @default("#1a1918")
  inkColor       String  @default("#f3f2f2")
  positiveColor  String  @default("#2dd4bf")
  warningColor   String  @default("#dc2626")
  locale         String  @default("en") // "en" | "cs" — the whole app's UI language, not just this record

  // Editable templates for the invoice "Send"/"Send reminder" buttons (Settings → Invoice emailing).
  // Plain-text with {{token}} placeholders — see src/lib/email.ts's EMAIL_TEMPLATE_TOKENS for the list.
  invoiceEmailSubject  String @default("Invoice {{invoiceNumber}} from {{companyName}}")
  invoiceEmailBody     String @default("Hi {{clientName}},\n\nPlease find attached invoice {{invoiceNumber}} for {{eventTitle}}, totaling {{amount}}, due {{dueDate}}.\n\nThank you,\n{{companyName}}")
  reminderEmailSubject String @default("Reminder: invoice {{invoiceNumber}} is overdue")
  reminderEmailBody    String @default("Hi {{clientName}},\n\nThis is a friendly reminder that invoice {{invoiceNumber}} for {{eventTitle}}, totaling {{amount}}, was due {{dueDate}} ({{daysOverdue}} days ago) and is still unpaid.\n\nThe invoice is attached again for your convenience.\n\nThank you,\n{{companyName}}")
}

// A real client company. Added going forward, not backfilled from existing
// Event.companyName/companyIco free-text fields — auto-matching those by
// name/IČO would be fragile (typos, "Kobra a.s." vs "Kobra, a.s." etc.) and
// silently merging the wrong events under one client is worse than just
// leaving old events unlinked. New events can pick or quick-create a
// Client; the Clients section's event list/total-charged figure is only
// ever as complete as which events actually got linked.
model Client {
  id     String @id @default(cuid())
  name   String
  // Structured rather than one free-text line, so it can round-trip through
  // the Photon worldwide-address autocomplete (src/lib/address-search.ts),
  // which already returns these as separate components. "state" covers
  // whatever Photon's own "state" field resolves to for the country in
  // question (a US/CA state/province, a Czech kraj, etc.) — not literal
  // country-level data, which Photon returns separately and isn't stored
  // here (matches how Event/CompanySettings addresses work today).
  street   String @default("")
  city     String @default("")
  postCode String @default("")
  state    String @default("")
  ico      String @default("")
  dic      String @default("")
  note     String @default("")
  // Where invoices should be sent. Editable directly, but also auto-filled
  // (only if still blank) from the first event contact with an email that
  // gets synced onto this client — see syncClientContacts() in actions/clients.ts.
  invoicingEmail String   @default("")
  createdAt      DateTime @default(now())

  contacts ClientContact[]
  events   Event[]

  @@index([name])
}

model ClientContact {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name     String
  role     String @default("")
  phone    String @default("")
  email    String @default("")
}

// Org-wide default categories offered when tagging a quote/invoice line item
// (seeded: Video, Audio, Rigging, People, Other). Admin/Accountant-editable
// in Settings. A quote can still tag an item with a category name that isn't
// in this list at all — that one-off name is just stored as free text on the
// item itself and never written back here (see QuoteItem.category).
model ItemCategory {
  id        String @id @default(cuid())
  name      String @unique
  sortOrder Int    @default(0)
}
